# Dependencies
node_modules/

# Build output real (o instalador gerado, não os recursos de build)
dist/
release/

# Recursos de build - ESTES SÃO VERSIONADOS (ícone, script NSIS), só o
# resultado do build (release/) é ignorado. Não coloque nada aqui além de
# arquivos de configuração pequenos.

# Binários de terceiros - grandes demais pro Git, baixados sob demanda
vendor/python/*
vendor/pandoc/*
vendor/7zip/*
vendor/ollama/*
!vendor/**/.gitkeep
!vendor/README.md

# Environment variables
.env
.env.local

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.cache/

# Electron
out/
src/config/googleCredentials.local.ts
