# Spotify Integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Google APIs (Gmail, Calendar, Spreadsheets)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:cloud

# Voz da Karen no Edge TTS (ex: pt-BR-FranciscaNeural, pt-BR-AntonioNeural)
TTS_VOICE_NAME=pt-BR-FranciscaNeural

# Tamanho do modelo Whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL_SIZE=small

# Vocabulário/nomes que o Whisper deve reconhecer melhor
WHISPER_INITIAL_PROMPT=Karen, assistente pessoal, abrir, arquivo, aplicativo, WhatsApp, e-mail, agenda.

# Development Environment
NODE_ENV=development
DEBUG=false
