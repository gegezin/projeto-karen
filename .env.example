# Copie este arquivo para ".env" e preencha com suas próprias credenciais.
# O ".env" já está no .gitignore - nunca vai parar em um repositório Git.

# Spotify (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Google (Gmail + Calendar) - necessário só quando essas integrações forem ligadas
# https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8888/callback
